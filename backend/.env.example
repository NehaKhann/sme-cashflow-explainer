# Copy to .env for local dev (not committed), or set these as environment
# variables in your Render dashboard for deployment.

# Free tier key from https://console.groq.com -- no credit card required.
# If unset, the app falls back to a deterministic templated narrative.
GROQ_API_KEY=

# Optional -- defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# JWT settings — generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chat provider: "ollama" (default, local) or "groq" (for deployment).
# When set to "groq", the chatbot uses GROQ API instead of a local Ollama instance.
# Requires GROQ_API_KEY to be set.
# CHAT_PROVIDER=groq

# Ollama — only needed if CHAT_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# CHAT_MODEL=ledger-chatbot

# When CHAT_PROVIDER=groq, CHAT_MODEL defaults to llama-3.3-70b-versatile.
# CHAT_MODEL=llama-3.3-70b-versatile
