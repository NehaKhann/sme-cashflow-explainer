# Docker Compose loads this file automatically.
# Copy to .env (gitignored) and fill in your keys.

# Free tier key from https://console.groq.com
GROQ_API_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chat: "ollama" for local (default) or "groq" for deployed environments.
# When set to "ollama", Ollama must be running on the host.
# CHAT_PROVIDER=ollama
# CHAT_MODEL=ledger-chatbot
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Database (optional — Docker Compose sets it automatically)
# DATABASE_URL=postgresql+asyncpg://cashflow:cashflow_dev@localhost:5432/cashflow
